# #217 rollout template only; no deployment or production provisioning implied.
# Apply additive Front migration first; deploy both apps OFF, then enable together.
JAOTHUI_EVENT_SSO_ENABLED=false
JAOTHUI_FRONT_ORIGIN=
JAOTHUI_EVENT_ORIGIN=
# Generate dedicated random keys >=32 characters. No existing key reuse.
# CLIENT_SECRET matches across apps; STATE_SECRET is independent per app.
JAOTHUI_EVENT_SSO_CLIENT_SECRET=
JAOTHUI_EVENT_SSO_STATE_SECRET=
# Existing web LINE callback/channel configuration remains unchanged.
# JAOTHUI_LINE_LOGIN_CHANNEL_ID must be the verified namespace 2003013735.
